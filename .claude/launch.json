        "-c",
        "cd ../Funnels-Club/packages/backend && exec node node_modules/convex/bin/main.js dev"
      ],
      "port": 3210,
      "autoPort": false
    },
    {
      "name": "crm",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../Funnels-Club/apps/web && exec node node_modules/next/dist/bin/next dev --port 3005"
      ],
      "port": 3005,
      "autoPort": false
